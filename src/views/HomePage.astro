---
import { render } from 'astro:content';

import ProfileHero from '../components/ProfileHero.astro';
import SkillSummary from '../components/SkillSummary.astro';
import { localizePath } from '../i18n/routes';
import { type Locale, ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getProfilePair,
  getPublishedExperiencePairs,
  getSkillPairs,
  resolveForLocale,
} from '../lib/content';
import { buildExperienceView, sortExperienceViews } from '../lib/experiences';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];

const profilePair = await getProfilePair();
const profile = resolveForLocale(profilePair, lang).entry;
const { Content: Bio } = await render(profile);

const experiencePairs = await getPublishedExperiencePairs();
const experienceViews = sortExperienceViews(
  experiencePairs.map((pair) => buildExperienceView(pair, lang, t.labels.present)),
);
const projects = experienceViews.filter((view) => view.kind === 'project').slice(0, 2);

const skillGroups = (await getSkillPairs())
  .map((pair) => ({
    slug: pair.slug,
    category: pair.zh.data.category,
    order: pair.zh.data.order,
    items: pair.zh.data.items,
  }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  lang={lang}
  title={t.siteName}
  description={`${profile.data.name} — ${profile.data.headline}`}
>
  <ProfileHero lang={lang} profile={profile.data} />

  <section class="shell grid gap-8 py-16 md:grid-cols-[180px_1fr] md:gap-12">
    <div>
      <p class="eyebrow">{t.headings.about}</p>
      <div class="mt-4 h-px w-12 bg-accent" aria-hidden="true"></div>
    </div>
    <div class="prose max-w-2xl">
      <Bio />
    </div>
  </section>

  <section class="border-y border-line bg-surface/50">
    <div class="shell py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{t.headings.selectedWork}</p>
          <h2 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">
            {t.headings.selectedWork}
          </h2>
        </div>
        <a
          href={localizePath('/experience/', lang)}
          class="group inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-ink/60 transition hover:text-accent"
        >
          {t.headings.allExperience}
          <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-9 grid gap-5 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <a
              href={project.href ?? localizePath('/experience/', lang)}
              class="group flex flex-col rounded-2xl border border-line bg-paper p-6 transition hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-[0_24px_60px_-40px_rgba(27,36,33,0.5)]"
            >
              <div class="flex items-center justify-between text-[11px] tracking-[0.16em] text-muted">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span class="flex items-center gap-2">
                  <span>{project.period}</span>
                </span>
              </div>
              <h3 class="mt-8 font-display text-2xl leading-snug tracking-tight transition group-hover:text-accent">
                {project.title}
              </h3>
              <p class="mt-1 text-sm text-muted">{project.org}</p>
              <p class="mt-4 flex-1 text-sm leading-6 text-ink/75">{project.summary}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                {project.tags.slice(0, 4).map((tag) => (
                  <span class="rounded-full border border-line px-2.5 py-1 text-[10px] font-medium text-ink/60">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-accent">
                {t.labels.viewCase}
                <span class="transition group-hover:translate-x-0.5" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="shell py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{t.headings.toolkit}</p>
        <h2 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">
          {t.headings.toolkit}
        </h2>
      </div>
      <a
        href={localizePath('/skills/', lang)}
        class="group inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-ink/60 transition hover:text-accent"
      >
        {t.nav.skills}
        <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
    </div>

    <SkillSummary groups={skillGroups.slice(0, 3)} />
  </section>

  <section class="bg-pine text-paper">
    <div class="shell grid gap-8 py-14 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-paper/50">
          {t.headings.contact}
        </p>
        <p class="mt-4 max-w-xl font-display text-3xl leading-tight tracking-tight sm:text-4xl">
          有想聊的项目，或者只是打个招呼，都可以写信给我。
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <a
          href={`mailto:${profile.data.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-paper px-5 py-2.5 text-sm font-medium text-pine transition hover:bg-accent hover:text-paper"
        >
          {profile.data.email}
          <span aria-hidden="true">↗</span>
        </a>
        <div class="flex flex-wrap gap-4 text-xs text-paper/60">
          {
            profile.data.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-paper"
              >
                {social.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
