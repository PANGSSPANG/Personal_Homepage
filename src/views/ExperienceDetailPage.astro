---
import { render } from 'astro:content';

import { localizePath } from '../i18n/routes';
import { type Locale, ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperiencePair } from '../lib/content';
import { buildExperienceView } from '../lib/experiences';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = ui[lang];

const pair = await getExperiencePair(slug);
const entry = pair.zh;

if (entry.data.kind !== 'project') {
  throw new Error(`只有项目类型有详情页：${slug}`);
}

const { Content } = await render(entry);
const view = buildExperienceView(pair, lang, t.labels.present);
const backHref = localizePath('/experience/', lang);
---

<BaseLayout lang={lang} title={view.title} description={view.summary}>
  <article class="mx-auto w-full max-w-4xl px-5 py-12 sm:px-8 md:py-16">
    <a
      href={backHref}
      class="group inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-ink/55 transition hover:text-accent"
    >
      <span class="transition group-hover:-translate-x-0.5" aria-hidden="true">←</span>
      {t.labels.backToExperience}
    </a>

    <header class="mt-8 border-b border-line pb-8">
      <p class="eyebrow">
        {t.kinds.project} · {view.period}
      </p>
      <h1 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">
        {view.title}
      </h1>
      <p class="mt-3 text-lg text-ink/60">
        {view.org}{view.location ? ` · ${view.location}` : ''}
      </p>
      <p class="mt-5 max-w-2xl text-[15px] leading-7 text-ink/75">{view.summary}</p>

      {
        view.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {view.tags.map((tag) => (
              <li class="rounded-full border border-line bg-surface px-2.5 py-1 text-[11px] font-medium text-ink/65">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose mt-10">
      <Content />
    </div>

    <footer
      class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6"
    >
      <a
        href={backHref}
        class="text-xs font-semibold tracking-wide text-ink/55 transition hover:text-accent"
      >
        ← {t.labels.backToExperience}
      </a>
      {
        view.links.length > 0 && (
          <div class="flex flex-wrap gap-4 text-xs">
            {view.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-semibold text-accent"
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }
    </footer>
  </article>
</BaseLayout>
