---
import { type Locale, ui } from '../i18n/ui';

interface Group {
  category: string;
  items: { name: string }[];
  isFallback: boolean;
}

interface Props {
  lang: Locale;
  groups: Group[];
}

const { lang, groups } = Astro.props;
const t = ui[lang];
---

<div class="mt-9 grid gap-x-10 gap-y-8 border-t border-ink/15 pt-8 md:grid-cols-3">
  {
    groups.map((group) => (
      <section>
        <div class="flex items-baseline justify-between gap-2">
          <h3 class="font-display text-lg tracking-tight">{group.category}</h3>
          {group.isFallback && (
            <span class="rounded-full border border-line px-2 py-0.5 text-[10px] font-semibold tracking-wide text-muted">
              {t.labels.fallbackBadge}
            </span>
          )}
        </div>

        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.slice(0, 4).map((item) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1.5 text-[12.5px] leading-none text-ink/70">
              {item.name}
            </li>
          ))}
          {group.items.length > 4 && (
            <li class="rounded-full px-2 py-1.5 text-[12.5px] leading-none text-muted">
              +{group.items.length - 4}
            </li>
          )}
        </ul>
      </section>
    ))
  }
</div>
