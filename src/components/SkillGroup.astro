---
import { type Locale, ui } from '../i18n/ui';

interface SkillItem {
  name: string;
  level?: string;
  years?: number;
  note?: string;
}

interface Props {
  lang: Locale;
  category: string;
  items: SkillItem[];
}

const { lang, category, items } = Astro.props;
const t = ui[lang];

const levelValue: Record<string, number> = {
  了解: 1,
  Basic: 1,
  熟悉: 2,
  Familiar: 2,
  熟练: 3,
  Proficient: 3,
  精通: 4,
  Expert: 4,
};
---

<article class="flex flex-col rounded-2xl border border-line bg-surface p-6" data-skill-group>
  <header class="flex items-start justify-between gap-3">
    <h2 class="font-display text-xl tracking-tight">{category}</h2>
  </header>

  <ul class="mt-5 divide-y divide-line/70">
    {
      items.map((item) => {
        const value = item.level ? (levelValue[item.level] ?? 0) : 0;
        return (
          <li class="py-3">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-medium">{item.name}</span>
              {item.years !== undefined && (
                <span class="shrink-0 text-[11px] text-muted">
                  {item.years} {t.labels.years}
                </span>
              )}
            </div>
            {item.level && (
              <div class="mt-2 flex items-center gap-2.5">
                <span class="flex gap-1" aria-hidden="true">
                  {[1, 2, 3, 4].map((step) => (
                    <span
                      class:list={['h-1 w-4 rounded-full', step <= value ? 'bg-accent' : 'bg-line']}
                    />
                  ))}
                </span>
                <span class="text-[11px] text-muted">{item.level}</span>
              </div>
            )}
            {item.note && <p class="mt-1.5 text-xs leading-5 text-muted">{item.note}</p>}
          </li>
        );
      })
    }
  </ul>
</article>
