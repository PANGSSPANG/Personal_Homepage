---
import '../styles/global.css';

import SampleNotice from '../components/SampleNotice.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { alternatePath, localizePath } from '../i18n/routes';
import { type Locale, ui } from '../i18n/ui';
import { getProfilePair, getSiteFlags, resolveForLocale } from '../lib/content';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];

const profilePair = await getProfilePair();
const profile = resolveForLocale(profilePair, lang).entry;
const { hasSample } = await getSiteFlags();

const path = Astro.url.pathname;
const fullTitle = title === profile.data.name ? title : `${title} · ${profile.data.name}`;
const metaDescription = description ?? `${profile.data.name} — ${profile.data.headline}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>

  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    {hasSample && <SampleNotice lang={lang} />}
    <SiteHeader
      lang={lang}
      name={profile.data.name}
      path={path}
      alternateHref={alternatePath(path)}
    />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="shell flex flex-col gap-3 py-8 text-[11px] tracking-wide text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} {profile.data.name} · {t.footer}</p>
        <div class="flex items-center gap-5">
          <a href={localizePath('/', lang)} class="transition hover:text-accent">
            {t.nav.home}
          </a>
          <a href={localizePath('/experience/', lang)} class="transition hover:text-accent">
            {t.nav.experience}
          </a>
          <a href="#main" aria-label="Top" class="transition hover:text-accent">↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
